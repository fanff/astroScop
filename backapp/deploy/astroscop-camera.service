[Unit]
Description=astroScop HQ camera worker (picamera2)
After=network.target astroscop-rootserver.service
Requires=astroscop-rootserver.service

[Service]
Type=simple
User=fanf
Group=fanf
SupplementaryGroups=video
WorkingDirectory=/home/fanf/astroScop/backapp
ExecStart=/usr/bin/python3 /home/fanf/astroScop/backapp/cam_picamera2.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
